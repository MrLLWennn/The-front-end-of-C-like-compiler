<?xml version="1.0" encoding="UTF-8"?>
<CodeBlocks_project_file>
	<FileVersion major="1" minor="6"/>
	<Project>
		<Option title="my_compiler"/>
		<Option makefile_is_custom="1"/>
		<Option compiler="gcc"/>
		<Option virtualFolders="CMake Files\;"/>
		<Build>
			<Target title="all">
				<Option working_dir="/mnt/d/clion/my_compiler/cmake-build-debug"/>
				<Option type="4"/>
				<MakeCommands>
					<Build command="/usr/bin/gmake -j12 -f &quot;/mnt/d/clion/my_compiler/cmake-build-debug/Makefile&quot;  VERBOSE=1 all"/>
					<CompileFile command="/usr/bin/gmake -j12 -f &quot;/mnt/d/clion/my_compiler/cmake-build-debug/Makefile&quot;  VERBOSE=1 &quot;$file&quot;"/>
					<Clean command="/usr/bin/gmake -j12 -f &quot;/mnt/d/clion/my_compiler/cmake-build-debug/Makefile&quot;  VERBOSE=1 clean"/>
					<DistClean command="/usr/bin/gmake -j12 -f &quot;/mnt/d/clion/my_compiler/cmake-build-debug/Makefile&quot;  VERBOSE=1 clean"/>
				</MakeCommands>
			</Target>
			<Target title="my_compiler">
				<Option output="/mnt/d/clion/my_compiler/cmake-build-debug/my_compiler" prefix_auto="0" extension_auto="0"/>
				<Option working_dir="/mnt/d/clion/my_compiler/cmake-build-debug"/>
				<Option object_output="./"/>
				<Option type="1"/>
				<Option compiler="gcc"/>
				<Compiler>
					<Add directory="/usr/include/c++/11"/>
					<Add directory="/usr/include/x86_64-linux-gnu/c++/11"/>
					<Add directory="/usr/include/c++/11/backward"/>
					<Add directory="/usr/lib/gcc/x86_64-linux-gnu/11/include"/>
					<Add directory="/usr/local/include"/>
					<Add directory="/usr/include/x86_64-linux-gnu"/>
					<Add directory="/usr/include"/>
				</Compiler>
				<MakeCommands>
					<Build command="/usr/bin/gmake -j12 -f &quot;/mnt/d/clion/my_compiler/cmake-build-debug/Makefile&quot;  VERBOSE=1 my_compiler"/>
					<CompileFile command="/usr/bin/gmake -j12 -f &quot;/mnt/d/clion/my_compiler/cmake-build-debug/Makefile&quot;  VERBOSE=1 &quot;$file&quot;"/>
					<Clean command="/usr/bin/gmake -j12 -f &quot;/mnt/d/clion/my_compiler/cmake-build-debug/Makefile&quot;  VERBOSE=1 clean"/>
					<DistClean command="/usr/bin/gmake -j12 -f &quot;/mnt/d/clion/my_compiler/cmake-build-debug/Makefile&quot;  VERBOSE=1 clean"/>
				</MakeCommands>
			</Target>
			<Target title="my_compiler/fast">
				<Option output="/mnt/d/clion/my_compiler/cmake-build-debug/my_compiler" prefix_auto="0" extension_auto="0"/>
				<Option working_dir="/mnt/d/clion/my_compiler/cmake-build-debug"/>
				<Option object_output="./"/>
				<Option type="1"/>
				<Option compiler="gcc"/>
				<Compiler>
					<Add directory="/usr/include/c++/11"/>
					<Add directory="/usr/include/x86_64-linux-gnu/c++/11"/>
					<Add directory="/usr/include/c++/11/backward"/>
					<Add directory="/usr/lib/gcc/x86_64-linux-gnu/11/include"/>
					<Add directory="/usr/local/include"/>
					<Add directory="/usr/include/x86_64-linux-gnu"/>
					<Add directory="/usr/include"/>
				</Compiler>
				<MakeCommands>
					<Build command="/usr/bin/gmake -j12 -f &quot;/mnt/d/clion/my_compiler/cmake-build-debug/Makefile&quot;  VERBOSE=1 my_compiler/fast"/>
					<CompileFile command="/usr/bin/gmake -j12 -f &quot;/mnt/d/clion/my_compiler/cmake-build-debug/Makefile&quot;  VERBOSE=1 &quot;$file&quot;"/>
					<Clean command="/usr/bin/gmake -j12 -f &quot;/mnt/d/clion/my_compiler/cmake-build-debug/Makefile&quot;  VERBOSE=1 clean"/>
					<DistClean command="/usr/bin/gmake -j12 -f &quot;/mnt/d/clion/my_compiler/cmake-build-debug/Makefile&quot;  VERBOSE=1 clean"/>
				</MakeCommands>
			</Target>
			<Target title="edit_cache">
				<Option working_dir="/mnt/d/clion/my_compiler/cmake-build-debug"/>
				<Option type="4"/>
				<MakeCommands>
					<Build command="/usr/bin/gmake -j12 -f &quot;/mnt/d/clion/my_compiler/cmake-build-debug/Makefile&quot;  VERBOSE=1 edit_cache"/>
					<CompileFile command="/usr/bin/gmake -j12 -f &quot;/mnt/d/clion/my_compiler/cmake-build-debug/Makefile&quot;  VERBOSE=1 &quot;$file&quot;"/>
					<Clean command="/usr/bin/gmake -j12 -f &quot;/mnt/d/clion/my_compiler/cmake-build-debug/Makefile&quot;  VERBOSE=1 clean"/>
					<DistClean command="/usr/bin/gmake -j12 -f &quot;/mnt/d/clion/my_compiler/cmake-build-debug/Makefile&quot;  VERBOSE=1 clean"/>
				</MakeCommands>
			</Target>
			<Target title="rebuild_cache">
				<Option working_dir="/mnt/d/clion/my_compiler/cmake-build-debug"/>
				<Option type="4"/>
				<MakeCommands>
					<Build command="/usr/bin/gmake -j12 -f &quot;/mnt/d/clion/my_compiler/cmake-build-debug/Makefile&quot;  VERBOSE=1 rebuild_cache"/>
					<CompileFile command="/usr/bin/gmake -j12 -f &quot;/mnt/d/clion/my_compiler/cmake-build-debug/Makefile&quot;  VERBOSE=1 &quot;$file&quot;"/>
					<Clean command="/usr/bin/gmake -j12 -f &quot;/mnt/d/clion/my_compiler/cmake-build-debug/Makefile&quot;  VERBOSE=1 clean"/>
					<DistClean command="/usr/bin/gmake -j12 -f &quot;/mnt/d/clion/my_compiler/cmake-build-debug/Makefile&quot;  VERBOSE=1 clean"/>
				</MakeCommands>
			</Target>
		</Build>
